#include <stdio.h>
#include <string.h>

// Cau 1: Dinh nghia cau truc Hang Hoa
typedef struct
{
    int maHang;
    char tenHang[50];
    int ngay;
    int thang;
    int nam;
    float gia;
} HangHoa;

// Cau 2: Ham nhap mang n hang hoa
void nhapMang(HangHoa a[], int n)
{
    int i;

    for(i = 0; i < n; i++)
    {
        printf("\nNhap hang hoa thu %d:", i + 1);

        printf("\nMa hang hoa: ");
        scanf("%d", &a[i].maHang);

        fflush(stdin);
        printf("Ten hang hoa: ");
        gets(a[i].tenHang);

        printf("Ngay xuat hang: ");
        scanf("%d", &a[i].ngay);

        printf("Thang xuat hang: ");
        scanf("%d", &a[i].thang);

        printf("Nam xuat hang: ");
        scanf("%d", &a[i].nam);

        printf("Gia xuat hang (trieu dong): ");
        scanf("%f", &a[i].gia);
    }
}

// Cau 3: Ham xuat mang n hang hoa
void xuatMang(HangHoa a[], int n)
{
    int i;

    printf("\n%-10s %-25s %-15s %-15s",
           "Ma hang", "Ten hang", "Ngay xuat", "Gia");

    printf("\n---------------------------------------------------------------");

    for(i = 0; i < n; i++)
    {
        printf("\n%-10d %-25s %02d/%02d/%04d      %-15.2f",
               a[i].maHang,
               a[i].tenHang,
               a[i].ngay,
               a[i].thang,
               a[i].nam,
               a[i].gia);
    }
}

// Cau 4: Selection Sort tang dan theo gia
void selectionSort(HangHoa a[], int n)
{
    int i, j, min;
    HangHoa temp;

    for(i = 0; i < n - 1; i++)
    {
        min = i;

        for(j = i + 1; j < n; j++)
        {
            if(a[j].gia < a[min].gia)
            {
                min = j;
            }
        }

        if(min != i)
        {
            temp = a[i];
            a[i] = a[min];
            a[min] = temp;
        }
    }
}

// Cau 5: Tim kiem nhi phan
void timKiemNhiPhan(HangHoa a[], int n, float x)
{
    int left = 0;
    int right = n - 1;
    int mid;
    int found = 0;

    while(left <= right)
    {
        mid = (left + right) / 2;

        if(a[mid].gia == x)
        {
            found = 1;

            // Tim sang ben trai de tim cac phan tu trung nhau
            int i = mid;

            while(i >= 0 && a[i].gia == x)
            {
                i--;
            }

            i++;

            // Hien thi tat ca hang hoa co gia = x
            while(i < n && a[i].gia == x)
            {
                printf("\nMa hang: %d", a[i].maHang);
                printf("\nTen hang: %s", a[i].tenHang);
                printf("\nNgay xuat: %02d/%02d/%04d",
                       a[i].ngay,
                       a[i].thang,
                       a[i].nam);
                printf("\nGia xuat hang: %.2f trieu dong", a[i].gia);
                printf("\n-----------------------------");

                i++;
            }

            break;
        }
        else if(a[mid].gia < x)
        {
            left = mid + 1;
        }
        else
        {
            right = mid - 1;
        }
    }

    if(found == 0)
    {
        printf("\nKhong tim thay hang hoa co gia %.2f", x);
    }
}

// Cau 6: Ham main
int main()
{
    HangHoa a[100];
    int n;
    float x;

    // Nhap n
    printf("Nhap so luong hang hoa n = ");
    scanf("%d", &n);

    // Nhap mang
    nhapMang(a, n);

    // Xuat mang vua nhap
    printf("\n\n===== DANH SACH HANG HOA VUA NHAP =====");
    xuatMang(a, n);

    // Sap xep
    selectionSort(a, n);

    printf("\n\n===== DANH SACH SAU KHI SAP XEP THEO GIA =====");
    xuatMang(a, n);

    // Nhap gia can tim
    printf("\n\nNhap gia X can tim (trieu dong): ");
    scanf("%f", &x);

    // Tim kiem nhi phan
    printf("\n===== CAC HANG HOA CO GIA %.2f =====", x);
    timKiemNhiPhan(a, n, x);

    return 0;
}
